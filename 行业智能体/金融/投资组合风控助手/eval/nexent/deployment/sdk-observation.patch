+# Optional diagnostic capture. No sink is configured by the SDK itself.
+_receipt_capture = ContextVar("nexent_optional_mcp_receipt_capture", default=None)
+_RECEIPT_TOOL_NAME = "evaluate_portfolio_snapshot"
+
+
+class _MCPReceiptCapture:
+    def __init__(self, call_id):
+        self._lock = threading.Lock()
+        self._closed = False
+        self._call_id = call_id if isinstance(call_id, str) and call_id else None
+        self._requests = 0
+        self._name = None
+        self._arguments = None
+        self._raw = None
+        self._capture_error = None
+
+    def begin(self, name, arguments):
+        with self._lock:
+            if self._closed:
+                return
+            self._requests += 1
+            if self._requests != 1:
+                return
+            self._name = name
+            try:
+                self._arguments = deepcopy(arguments)
+            except Exception as exc:
+                self._capture_error = type(exc).__name__
+
+    def returned(self, result):
+        # exclude_unset preserves the difference between an explicit wire field
+        # and a Pydantic default, notably CallToolResult.isError == False.
+        try:
+            if hasattr(result, "model_dump"):
+                raw = result.model_dump(mode="json", by_alias=True, exclude_unset=True)
+            elif isinstance(result, dict):
+                raw = deepcopy(result)
+            else:
+                raw = None
+        except Exception as exc:
+            with self._lock:
+                if not self._closed:
+                    self._capture_error = type(exc).__name__
+            return
+        with self._lock:
+            if not self._closed and self._requests == 1:
+                self._raw = raw
+
+    def finish(self, *, accepted, error_type=None):
+        with self._lock:
+            if self._closed:
+                return None
+            self._closed = True
+            if self._name != _RECEIPT_TOOL_NAME:
+                return None
+            raw = self._raw
+            structured = raw.get("structuredContent") if isinstance(raw, dict) else None
+            has_array = (isinstance(structured, dict)
+                         and "result" in structured
+                         and isinstance(structured["result"], list))
+            explicit_ok = (isinstance(raw, dict)
+                           and "isError" in raw and raw["isError"] is False)
+            explicit_error = isinstance(raw, dict) and raw.get("isError") is True
+            arguments_ok = (isinstance(self._arguments, dict)
+                            and "portfolio" in self._arguments
+                            and "snapshot" in self._arguments)
+            success = bool(accepted and not error_type and explicit_ok and has_array
+                           and self._call_id and arguments_ok
+                           and self._requests == 1 and not self._capture_error)
+            status = ("success" if success else "failed"
+                      if not accepted or error_type or explicit_error else "insufficient")
+            record = {
+                "schema": "topic16-platform-mcp-receipt-v1",
+                "source": "nexent-execution-record",
+                "tool_name": self._name,
+                "call_id": self._call_id,
+                "arguments": self._arguments,
+                "tool_success": success,
+                "status": status,
+                "outer_result_accepted": bool(accepted),
+                "rpc_count": self._requests,
+                "explicit_is_error_false": explicit_ok,
+                "explicit_result_array": has_array,
+                "mcp_raw_result": raw,
+            }
+            if has_array:
+                record["result"] = deepcopy(structured["result"])
+            if error_type:
+                record["error_type"] = error_type
+            if self._capture_error:
+                record["capture_error_type"] = self._capture_error
+            return record
 
 
