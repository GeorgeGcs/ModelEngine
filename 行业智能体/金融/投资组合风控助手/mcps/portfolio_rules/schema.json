{
  "sdk": "mcp==2.3.0",
  "tools": [
    {
      "name": "evaluate_portfolio_snapshot",
      "description": "按行情快照检查止损与止盈，含等于阈值的情形。价格使用十进制字符串或整数。\n\n    timestamp 使用带时区的 ISO 8601 时间。返回命中的信号列表，未命中时返回空列表。\n    ",
      "inputSchema": {
        "$defs": {
          "Holding": {
            "properties": {
              "symbol": {
                "title": "Symbol",
                "type": "string"
              },
              "stop_loss": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "title": "Stop Loss"
              },
              "take_profit": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "title": "Take Profit"
              }
            },
            "required": [
              "symbol",
              "stop_loss",
              "take_profit"
            ],
            "title": "Holding",
            "type": "object"
          },
          "Portfolio": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "holdings": {
                "items": {
                  "$ref": "#/$defs/Holding"
                },
                "title": "Holdings",
                "type": "array"
              }
            },
            "required": [
              "id",
              "holdings"
            ],
            "title": "Portfolio",
            "type": "object"
          },
          "Snapshot": {
            "properties": {
              "timestamp": {
                "title": "Timestamp",
                "type": "string"
              },
              "prices": {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "title": "Prices",
                "type": "object"
              }
            },
            "required": [
              "timestamp",
              "prices"
            ],
            "title": "Snapshot",
            "type": "object"
          }
        },
        "properties": {
          "portfolio": {
            "$ref": "#/$defs/Portfolio"
          },
          "snapshot": {
            "$ref": "#/$defs/Snapshot"
          }
        },
        "required": [
          "portfolio",
          "snapshot"
        ],
        "title": "evaluate_portfolio_snapshotArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Result",
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "title": "evaluate_portfolio_snapshotOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
